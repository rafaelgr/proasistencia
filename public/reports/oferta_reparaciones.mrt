        "NameInSource": "PROAS_REPORT",
        "SqlCommand": "SELECT o.ofertaId, o.referencia, DATE_FORMAT(o.fechaOferta,'%d-%m-%Y') AS fechaOferta,\ne.nombre AS nombreEmpresa, e.nif AS nifEmpresa,\nTRIM(CONCAT(COALESCE(tv1.nombre, ''), ' ' , e.direccion)) AS empresaDireccion, \ne.codPostal AS empresaCodPostal, e.poblacion AS empresaPoblacion, e.provincia AS empresaProvincia,\nc.nombre AS clienteNombre, c.nif AS clienteNif, \nTRIM(CONCAT(COALESCE(tv2.nombre, ''), ' ', c.direccion2)) AS clienteDireccionTrabajo, \nTRIM(CONCAT(COALESCE(tv2.nombre, ''), ' ', c.direccion)) AS clienteDireccionFiscal, \nc.codPostal2 AS clienteCodPostal, c.poblacion2 AS clientePoblacion, c.provincia2 AS clienteProvincia,\no.total, o.totalConIva, o.observaciones,\nfp.nombre AS formaPago\nFROM ofertas AS o\nLEFT JOIN empresas AS e ON e.empresaId = o.empresaId\nLEFT JOIN clientes AS c ON c.clienteId = o.clienteId\nLEFT JOIN formas_pago AS fp ON fp.formaPagoId = o.formaPagoId\nLEFT JOIN tipos_via AS tv1 ON tv1.tipoViaId = e.tipoViaId\nLEFT JOIN tipos_via AS tv2 ON tv2.tipoViaId = c.tipoViaId"
      },
