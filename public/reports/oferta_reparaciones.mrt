          },
          "12": {
            "Name": "impDescUni",
            "NameInSource": "impDescUni",
            "Alias": "impDescUni",
            "Type": "System.Decimal"
          },
          "13": {
            "Name": "primera_linea",
            "NameInSource": "primera_linea",
            "Alias": "primera_linea",
            "Type": "System.String"
          },
          "14": {
            "Name": "resto_lineas",
            "NameInSource": "resto_lineas",
            "Alias": "resto_lineas",
            "Type": "System.String"
          }
        },
        "NameInSource": "PROAS_REPORT",
        "SqlCommand": "SELECT ol.ofertaId, ol.ofertaLineaId, \nol.linea, ol.capituloLinea, ol.descripcion, ol.cantidad, ol.totalLinea, ol.importe, ol.perdto, \nu.abrev, a.nombre AS articulo, a.articuloId, ROUND(ol.importe - (ol.importe * (ol.perdto / 100)), 2) AS  impDescUni, SUBSTRING_INDEX(ol.descripcion, '\\n', 1) AS primera_linea,\nCASE \n WHEN LOCATE('\\n', ol.descripcion) > 0 THEN SUBSTRING(ol.descripcion, LOCATE('\\n', ol.descripcion) + 1)\n ELSE ''\n END AS resto_lineas\nFROM ofertas_lineas AS ol\nLEFT JOIN unidades AS u on u.unidadId = ol.unidadId\nLEFT JOIN articulos AS a ON a.articuloId = ol.articuloId\nORDER BY 4,3"
      }
    },
