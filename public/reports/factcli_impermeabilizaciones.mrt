        },
        "NameInSource": "PROA_REPORT",
        "SqlCommand": "SELECT pf.facturaId, pf.prefacturaId, pf.ano, pf.numero, pf.serie,  DATE_FORMAT(pf.fecha,'%d/%m/%Y') AS fecha, pf.empresaId, pf.clienteId, \npf.contratoClienteMantenimientoId,pf.importeAnticipo, pf.restoCobrar, pf.emisorNif, pf.emisorNombre, pf.emisorDireccion, pf.emisorCodPostal, \npf.emisorPoblacion, pf.emisorProvincia, tpv1.nombre AS receptorTipoVia,pf.receptorNif, pf.receptorNombre, pf.receptorDireccion, pf.receptorCodPostal, pf.receptorPoblacion, \npf.receptorProvincia,pf.total, pf.totalConIva, fp.nombre AS formaPago, fp.formapagoId AS formapagoId, pf.observaciones, pf.periodo, pf.porcentajeRetencion, pf.importeRetencion,\nfp.numeroVencimientos, fp.primerVencimiento, fp.restoVencimiento, cl.proId, tpv.nombre AS postalTipoVia, cl.direccion3 AS postalDireccion, \ncl.codPostal3 AS postalCodPostal, cl.poblacion3 AS postalPoblacion, cl.provincia3 AS postalProvincia,cl.iban, \nDATE_ADD(pf.fecha,INTERVAL fp.primerVencimiento + 1 DAY) AS vencimiento,pf.retenGarantias,\nCONCAT(SUBSTR(cl.iban,1,20), \"****\")  AS cuenta,\ncnt.direccion AS direccion2, cnt.codPostal AS codPostal2, cnt.poblacion AS poblacion2, cnt.provincia AS provincia2,\ncom.direccion AS direccionAgente, com.poblacion AS poblacionAgente, com.provincia AS provinciaAgente, com.codPostal AS codPostalAgente,\ncom.nif AS nifAgente, com.nombre AS nombreAgente, tpv2.nombre AS agenteTipoVia, cnt.referencia AS refOferta,\nCONCAT(\n    serie,\n    '-',\n    ano,\n    '-',\n    LPAD(numero, 6, '0')\n) AS numeroFactura\nFROM facturas AS pf\nLEFT JOIN formas_pago AS fp ON fp.formaPagoId = pf.formapagoId\nLEFT JOIN clientes AS cl ON cl.clienteId = pf.clienteId\nLEFT JOIN tipos_via AS tpv ON tpv.tipoViaId = cl.tipoViaId3\nLEFT JOIN tipos_via AS tpv1 ON tpv1.tipoViaId = cl.tipoViaId\nLEFT JOIN comerciales AS com ON com.comercialId = cl.comercialId\nLEFT JOIN tipos_via AS tpv2 ON tpv2.tipoViaId = com.tipoViaId\nLEFT JOIN contratos AS cnt ON cnt.contratoId = pf.contratoId\nLEFT JOIN ofertas AS of ON of.ofertaId = cnt.ofertaId\nwhere  facturaId=37329\n\n\n"
      },
