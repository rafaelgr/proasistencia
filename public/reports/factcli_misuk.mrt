            "Type": "System.String"
          }
        },
        "NameInSource": "PROA_REPORT",
        "SqlCommand": "SELECT pfl.*, t.nombre AS tipoIva, ga.nombre AS grupo, par.numparte, ser.numservicio, u.abrev, pl.codigoArticulo, ser.direccionTrabajo\nFROM facturas_lineas AS pfl\nLEFT JOIN tipos_iva AS t ON t.tipoIvaId = pfl.tipoIvaId\nLEFT JOIN articulos AS a ON a.articuloId = pfl.articuloId\nLEFT JOIN grupo_articulo AS ga ON ga.grupoArticuloId = a.grupoArticuloId\nLEFT JOIN `partes_lineas` AS pl ON pl.`facturaLineaId` = pfl.`facturaLineaId`\nLEFT JOIN `partes` AS par ON par.`parteId` = pl.`parteId`\nLEFT JOIN servicios AS ser ON ser.servicioId = par.servicioId\nLEFT JOIN unidades AS u ON u.unidadId = pfl.unidadId\n"
      }
    },
